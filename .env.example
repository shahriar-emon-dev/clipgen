# ─── AI Shorts Generator — Environment Variables ───

# Server
PORT=3001
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=change-this-to-a-long-random-string-in-production

# FFmpeg (leave empty to auto-detect)
FFMPEG_PATH=
FFPROBE_PATH=

# AI & Transcription Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000

# Transcription
TRANSCRIPTION_PROVIDER=openai
# Options: openai (Whisper API), local (faster-whisper via Python)
# For local: requires Python 3.9+ and faster-whisper installed
FASTER_WHISPER_MODEL=base

# Processing Pipeline (Optimized for 20-30 min videos)
MAX_VIDEO_DURATION=3600
MAX_UPLOAD_SIZE=5368709120
MAX_SHORTS_COUNT=10
MAX_SHORT_DURATION=30
MIN_SHORT_DURATION=15
ANALYSIS_CHUNK_SIZE=120
CHUNK_OVERLAP=30

# Output (YouTube Shorts / TikTok / Reels — 9:16 Vertical Ratio)
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=30
OUTPUT_FORMAT=mp4
# Standard YouTube Shorts 9:16 vertical video (1080x1920 at 30fps)
